+  right: -100px;
+  bottom: 12%;
+  background: radial-gradient(circle, rgba(34, 211, 238, 0.85), transparent 72%);
+  animation-delay: 2.5s;
+}
+
+.app-layer {
+  position: relative;
+  z-index: 1;
+}
+
+.card-bubbly {
+  border-radius: 22px;
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  background: linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(248, 250, 252, 0.82));
+  backdrop-filter: blur(6px);
+  box-shadow: 0 14px 40px rgba(15, 23, 42, 0.18);
+}
+
+@keyframes popIn {
+  from {
+    transform: scale(0.86);
+    opacity: 0;
+  }
+  to {
+    transform: scale(1);
+    opacity: 1;
+  }
+}
+
+@keyframes modePulse {
+  0% {
+    transform: scale(0.97);
+    box-shadow: 0 0 0 rgba(99, 102, 241, 0);
+  }
+  65% {
+    transform: scale(1.03);
+    box-shadow: 0 10px 28px rgba(99, 102, 241, 0.35);
+  }
+  100% {
+    transform: scale(1);
+    box-shadow: 0 0 0 rgba(99, 102, 241, 0);
+  }
+}
+
+@keyframes bubbleDrift {
+  0%,
+  100% {
+    transform: translateY(0px) translateX(0px);
+  }
+  50% {
+    transform: translateY(-24px) translateX(14px);
+  }
+}
+
+@keyframes modeGlowSweep {
+  0% {
+    opacity: 0;
+    transform: translateX(-20%);
+  }
+  50% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+    transform: translateX(120%);
+  }
+}
+
+.mode-card-animate {
+  animation: modePulse 380ms ease;
+}
+
+.mode-glow::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.28) 45%, transparent 90%);
+  animation: modeGlowSweep 550ms ease;
+  pointer-events: none;
+}
+
