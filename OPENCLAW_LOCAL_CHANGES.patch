+  position: relative;
+  overflow-x: hidden;
+}
+
+.app-surface::before,
+.app-surface::after {
+  content: "";
+  position: fixed;
+  width: 320px;
+  height: 320px;
+  border-radius: 9999px;
+  filter: blur(50px);
+  opacity: 0.32;
+  pointer-events: none;
+  z-index: 0;
+  animation: bubbleDrift 16s ease-in-out infinite;
